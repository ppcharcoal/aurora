{
  "name": "aurora",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Aurora — a fast, good-looking player for your own music, with YouTube/SoundCloud downloads.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "app:dev": "npm run discord:build && tauri dev",
    "app:build": "npm run discord:build && tauri build",
    "android:init": "tauri android init && node scripts/android-setup.mjs",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --split-per-abi --target aarch64",
    "android:signing": "node scripts/android-signing.mjs",
    "linux:core": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin aurora-core --no-default-features --features core",
    "linux:ui": "vite build --mode electron",
    "linux:start": "npm run linux:core && npm run linux:ui && npm run discord:build && npm --prefix electron start -- --no-sandbox",
    "linux:build": "npm run linux:core && npm run linux:ui && npm run discord:build && npm --prefix electron run dist",
    "discord:build": "npm --prefix discord install --no-audit --no-fund && npm --prefix discord run build"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.0"
  }
}
